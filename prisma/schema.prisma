generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// -----------------------------------------------------------------------------
// IDENTITY & MULTI-TENANCY
// -----------------------------------------------------------------------------

model User {
  id            String    @id @default(cuid())
  email         String    @unique
  name          String?
  role          String    @default("USER") // USER, OPERATOR, SUPER_ADMIN
  passwordHash  String?
  emailVerified DateTime?
  image         String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  // Relations
  memberships               OrganizationMember[]
  studentProfile            StudentProfile?
  professionalProfile       ProfessionalProfile?
  assignedLeads             Lead[]                    @relation("LeadAssignee")
  closedDeals               Deal[]                    @relation("DealCloser")
  appointments              Appointment[]             @relation("AppointmentCloser")
  emergencySupportSessions  EmergencySupportAccess[]  @relation("EmergencyOperator")
  sentInvites               WorkspaceInvite[]         @relation("InviteSender")
  sessions                  UserSession[]
}

model Organization {
  id                  String    @id @default(cuid())
  name                String
  slug                String    @unique
  status              String    @default("PENDING") // PENDING, APPROVED, SUSPENDED
  plan                String    @default("STARTER") // e.g. STARTER, GROWTH, SCALE
  qualificationPolicy String?   // Custom ICP/Qualification rules for this tenant
  leadRoutingMode     String    @default("OPEN_POOL") // OPEN_POOL, ROUND_ROBIN, OWNER_MANUAL
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  // Relations
  members             OrganizationMember[]
  leads               Lead[]
  contacts            Contact[]
  opportunities       Opportunity[]
  customStages        CustomPipelineStage[]
  conversations       Conversation[]
  appointments        Appointment[]
  aiActions           AiAction[]
  deals               Deal[]
  auditLogs           AuditLog[]
  followUpTasks       FollowUpTask[]
  revenueActions      RevenueAction[]
  revenueSignals      RevenueSignal[]
  revenueLeaks        RevenueLeak[]
  
  // Pilot & Billing Relations
  subscription        WorkspaceSubscription?
  supportRequests     SalesSupportRequest[]
  pilotEngagements    PilotEngagement[]
  clientReadinessList ClientOfferReadiness[]
  blockers            ClientBlocker[]
  operationalIssues   OperationalIssue[]
  bachsInvoices       BachsInvoice[]
  invites             WorkspaceInvite[]
  emergencyAccess     EmergencySupportAccess[]
  servicePackages     ServicePackage[]
  qualityReviews      CallQualityReview[]
  attributedOpportunities AttributedOpportunity[]
  outboxMessages      OutboxMessage[]

  // LMS Relations
  studentProfiles StudentProfile[]
  cohorts         Cohort[]
  courses         Course[]
  modules         Module[]
  resources       Resource[]
  roleplayScenarios RoleplayScenario[]
}

model OrganizationMember {
  id                      String       @id @default(cuid())
  role                    String       @default("MEMBER") // OWNER, ADMIN, MANAGER, CLOSER, SETTER, MEMBER, EXTERNAL_PROFESSIONAL
  isAvailable             Boolean      @default(true)     // Available to receive/claim qualified leads
  commissionRate          Float        @default(10.0)     // Commission percentage or fixed payout
  commissionType          String       @default("PERCENTAGE") // PERCENTAGE, FIXED_PER_DEAL, FIXED_PER_APPOINTMENT
  googleCalendarConnected Boolean      @default(false)
  googleCalendarEmail     String?
  reminderChannels        String       @default("WHATSAPP_EMAIL") // WHATSAPP, EMAIL, WHATSAPP_EMAIL, SMS
  createdAt               DateTime     @default(now())
  updatedAt               DateTime     @updatedAt

  // Foreign Keys
  userId         String
  organizationId String

  // Relations
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([userId, organizationId])
  @@index([organizationId])
}

// -----------------------------------------------------------------------------
// CORE SAAS & CRM (TENANT ISOLATED)
// -----------------------------------------------------------------------------

model Lead {
  id             String       @id @default(cuid())
  type           String       @default("MARKETING_LEAD") // MARKETING_LEAD, SALES_LEAD
  name           String
  email          String
  phone          String?
  message        String?
  status         String       @default("NEW") // NEW, CONTACTED, QUALIFIED, PROPOSAL_SENT, WON, LOST
  source         String?      // e.g., Website Widget, Manual Import, Referral
  buyingIntent   Int?         // 1-100 AI score
  estimatedValue Float?       // Estimated opportunity value
  currency       String?      @default("NGN")
  disqualificationReason String?
  nextAction     String?      // Scheduled next action description
  nextActionDueAt DateTime?   // Timezone-aware due date/time for next action
  blockerStatus  String?      @default("NONE") // NONE, WAITING_ON_CLIENT
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  // Foreign Keys
  organizationId String?      // Optional for platform-owned marketing leads, required for SaaS leads
  assignedUserId String?      // Assigned Setter, Closer, or Team Member
  assignedRole   String?      // SETTER, CLOSER
  pilotEngagementId String?   // Scoped active pilot engagement (if represented)
  claimedAt      DateTime?
  aiAssessment   String?      // Deep AI qualification breakdown & deal risk
  nextStepsRecommendation String? // Prescriptive coaching for setter/closer

  contactId      String?
  isArchived     Boolean      @default(false)
  archivedAt     DateTime?
  archiveReason  String?
  mergedIntoLeadId String?
  customStageId  String?

  // Relations
  organization   Organization? @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  assignedUser   User?         @relation("LeadAssignee", fields: [assignedUserId], references: [id], onDelete: SetNull)
  pilotEngagement PilotEngagement? @relation(fields: [pilotEngagementId], references: [id], onDelete: SetNull)
  contact        Contact?      @relation(fields: [contactId], references: [id], onDelete: SetNull)
  customStage    CustomPipelineStage? @relation(fields: [customStageId], references: [id], onDelete: SetNull)
  opportunities  Opportunity[]
  qualityReviews CallQualityReview[]
  blockers       ClientBlocker[]
  conversations  Conversation[]
  appointments   Appointment[]
  aiActions      AiAction[]
  deals          Deal[]
  auditLogs      AuditLog[]
  followUpTasks  FollowUpTask[]
  qualificationData QualificationData?
  revenueActions RevenueAction[]
  revenueSignals RevenueSignal[]
  revenueLeaks   RevenueLeak[]

  @@index([organizationId])
  @@index([contactId])
  @@index([isArchived])
  @@index([email])
  @@index([assignedUserId])
  @@index([pilotEngagementId])
}

model Conversation {
  id             String       @id @default(cuid())
  channel        String       @default("WHATSAPP") // WEB, EMAIL, WHATSAPP
  status         String       @default("ACTIVE") // ACTIVE, CLOSED, PAUSED
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  // Foreign Keys
  leadId         String
  organizationId String

  // Relations
  lead           Lead         @relation(fields: [leadId], references: [id], onDelete: Cascade)
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  messages       Message[]

  @@index([organizationId])
  @@index([leadId])
}

model Appointment {
  id              String       @id @default(cuid())
  title           String?
  scheduledAt     DateTime
  durationMinutes Int          @default(30)
  status          String       @default("SCHEDULED") // SCHEDULED, CONFIRMED, COMPLETED, NO_SHOW, CANCELLED
  meetingUrl      String?      // Zoom or Google Meet link
  notes           String?
  googleEventId   String?      // Synced Google Calendar event ID
  reminderSent    Boolean      @default(false)
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt

  // Foreign Keys
  leadId         String
  organizationId String
  closerId       String?      // Assigned closer or setter

  // Relations
  lead           Lead         @relation(fields: [leadId], references: [id], onDelete: Cascade)
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  closer         User?        @relation("AppointmentCloser", fields: [closerId], references: [id], onDelete: SetNull)

  @@index([organizationId])
  @@index([closerId])
}

model AiAction {
  id             String       @id @default(cuid())
  actionType     String       // e.g. QUALIFY, DRAFT_EMAIL, RECOMMEND_NEXT_STEP
  confidence     Float        // e.g. 0.95
  result         String
  status         String       @default("PENDING_APPROVAL") // PENDING_APPROVAL, APPROVED, REJECTED, EXECUTED
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  // Foreign Keys
  leadId         String
  organizationId String

  // Relations
  lead           Lead         @relation(fields: [leadId], references: [id], onDelete: Cascade)
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId])
}

model Deal {
  id               String       @id @default(cuid())
  title            String?
  amount           Float
  currency         String       @default("NGN")
  stage            String       @default("OPPORTUNITY") // OPPORTUNITY, PROPOSAL, NEGOTIATION, WON, LOST
  closedAt         DateTime?
  closerId         String?      // Assigned closer
  commissionAmount Float?       // Computed commission
  commissionStatus String       @default("PENDING") // PENDING, APPROVED, PAID
  notes            String?
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt

  // Foreign Keys
  leadId         String
  organizationId String

  // Relations
  lead           Lead         @relation(fields: [leadId], references: [id], onDelete: Cascade)
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  closer         User?        @relation("DealCloser", fields: [closerId], references: [id], onDelete: SetNull)

  @@index([organizationId])
  @@index([closerId])
}

model Message {
  id             String       @id @default(cuid())
  content        String
  senderType     String       // AI, HUMAN, PROSPECT
  createdAt      DateTime     @default(now())

  conversationId String
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([conversationId])
}

model AuditLog {
  id             String       @id @default(cuid())
  actorId        String?
  actorType      String       // USER, AI, SYSTEM, INTEGRATION
  actorRole      String?      // e.g. OWNER, OPERATOR, PLATFORM_ADMIN
  actorIp        String?
  action         String
  reason         String?      // Stated justification (required for emergency access or overrides)
  resourceType   String
  resourceId     String
  oldState       String?
  newState       String?
  metadata       String?      // JSON contextual details
  createdAt      DateTime     @default(now())

  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  leadId         String?
  lead           Lead?        @relation(fields: [leadId], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@index([leadId])
  @@index([action])
}

model FollowUpTask {
  id             String       @id @default(cuid())
  actionType     String       // e.g. SEND_WHATSAPP, NOTIFY_SALES
  scheduledFor   DateTime
  status         String       @default("PENDING") // PENDING, EXECUTED, CANCELLED
  reason         String?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  leadId         String
  lead           Lead         @relation(fields: [leadId], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@index([leadId])
  @@index([status, scheduledFor])
}

model QualificationData {
  id             String       @id @default(cuid())
  budget         String?
  authority      String?
  need           String?
  timeline       String?
  customData     String?      // JSON string for extra fields
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  leadId         String       @unique
  lead           Lead         @relation(fields: [leadId], references: [id], onDelete: Cascade)
}


// -----------------------------------------------------------------------------
// REVENUE ENGINE & EVENT LOOP
// -----------------------------------------------------------------------------

model RevenueAction {
  id               String       @id @default(cuid())
  type             String       // e.g. RESPOND, ASSIGN_HUMAN, SEND_BOOKING_LINK
  reason           String?
  priority         Int          // 1-100
  recommendedActor String       // AI, AUTOMATION, HUMAN, SYSTEM
  assignedUserId   String?
  scheduledAt      DateTime?
  executedAt       DateTime?
  status           String       @default("PENDING") // PENDING, QUEUED, EXECUTING, COMPLETED, FAILED, CANCELLED
  confidence       Float?
  source           String?
  result           String?
  cancellationReason String?
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt

  organizationId   String
  organization     Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  leadId           String
  lead             Lead         @relation(fields: [leadId], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@index([leadId])
  @@index([status, scheduledAt])
}

model RevenueSignal {
  id             String       @id @default(cuid())
  type           String       // INTENT, FIT, URGENCY, VALUE, ENGAGEMENT
  value          Int          // 1-100 score
  evidence       String?      // Explanation or context
  source         String       // AI, SYSTEM, HUMAN
  createdAt      DateTime     @default(now())

  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  leadId         String
  lead           Lead         @relation(fields: [leadId], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@index([leadId])
}

model RevenueLeak {
  id             String       @id @default(cuid())
  type           String       // e.g. SLA_BREACHED, NO_ACTION, STALLED_OPPORTUNITY
  description    String
  severity       String       // LOW, MEDIUM, HIGH, CRITICAL
  status         String       @default("OPEN") // OPEN, RESOLVED, IGNORED
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  leadId         String?
  lead           Lead?        @relation(fields: [leadId], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@index([leadId])
  @@index([status])
}


// -----------------------------------------------------------------------------
// DSS LEARNING MANAGEMENT SYSTEM (LMS)
// -----------------------------------------------------------------------------

model StudentProfile {
  id             String       @id @default(cuid())
  bio            String?
  track          String?      // SETTER, CLOSER
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  userId         String       @unique
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  enrollments    Enrollment[]
  roleplaySessions RoleplaySession[]
  lessonProgress LessonProgress[]
  moduleProgress ModuleProgress[]
  quizAttempts   QuizAttempt[]
  submissions    Submission[]
  assessmentScores AssessmentScore[]
  competencies   CompetencyScore[]
  portfolio      PortfolioArtifact[]
  certifications CertificationAttempt[]
  applications   Application[]
  payments       Payment[]
  
  @@index([organizationId])
}

model Cohort {
  id             String       @id @default(cuid())
  name           String
  startDate      DateTime
  endDate        DateTime?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  
  enrollments    Enrollment[]

  @@index([organizationId])
}

model Enrollment {
  id             String       @id @default(cuid())
  status         String       @default("ACTIVE") // ACTIVE, COMPLETED, DROPPED
  enrolledAt     DateTime     @default(now())

  studentId      String
  student        StudentProfile @relation(fields: [studentId], references: [id], onDelete: Cascade)
  
  cohortId       String
  cohort         Cohort       @relation(fields: [cohortId], references: [id], onDelete: Cascade)

  courseId       String?
  course         Course?      @relation(fields: [courseId], references: [id], onDelete: Cascade)

  @@unique([studentId, cohortId])
  @@index([cohortId])
  @@index([courseId])
}

model Module {
  id             String       @id @default(cuid())
  title          String
  orderIndex     Int
  description    String?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  
  courseId       String?
  course         Course?      @relation(fields: [courseId], references: [id], onDelete: Cascade)

  partId         String?
  part           Part?        @relation(fields: [partId], references: [id], onDelete: Cascade)

  lessons        Lesson[]
  prerequisitesFor ModulePrerequisite[] @relation("ModuleToPrerequisite")
  prerequisites    ModulePrerequisite[] @relation("PrerequisiteToModule")
  progress       ModuleProgress[]
  quizzes        Quiz[]
  assignments    Assignment[]

  @@index([organizationId])
  @@index([partId])
}

model Lesson {
  id             String       @id @default(cuid())
  title          String
  orderIndex     Int
  contentUrl     String?      // Video or PDF link
  transcript     String?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  moduleId       String
  module         Module       @relation(fields: [moduleId], references: [id], onDelete: Cascade)
  
  progress       LessonProgress[]

  @@index([moduleId])
}

model RoleplayScenario {
  id             String       @id @default(cuid())
  title          String
  buyerPersona   String       // e.g., CEO, CTO, CFO
  context        String       // Scenario instructions for the AI
  rubric         String       // JSON defining what to score (e.g. discovery, objection handling)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  sessions       RoleplaySession[]

  @@index([organizationId])
}

model RoleplaySession {
  id             String       @id @default(cuid())
  status         String       @default("IN_PROGRESS") // IN_PROGRESS, COMPLETED, FAILED
  finalScore     Int?
  feedback       String?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  studentId      String
  student        StudentProfile @relation(fields: [studentId], references: [id], onDelete: Cascade)
  
  scenarioId     String
  scenario       RoleplayScenario @relation(fields: [scenarioId], references: [id], onDelete: Cascade)

  turns          RoleplayTurn[]

  @@index([studentId])
  @@index([scenarioId])
}

model RoleplayTurn {
  id             String       @id @default(cuid())
  content        String
  senderType     String       // STUDENT, AI_BUYER
  createdAt      DateTime     @default(now())

  sessionId      String
  session        RoleplaySession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@index([sessionId])
}

model ModulePrerequisite {
  id             String       @id @default(cuid())
  moduleId       String
  prerequisiteId String
  
  module         Module       @relation("ModuleToPrerequisite", fields: [moduleId], references: [id], onDelete: Cascade)
  prerequisite   Module       @relation("PrerequisiteToModule", fields: [prerequisiteId], references: [id], onDelete: Cascade)
  
  @@unique([moduleId, prerequisiteId])
}

model LessonProgress {
  id             String       @id @default(cuid())
  studentId      String
  lessonId       String
  status         String       @default("NOT_STARTED") // NOT_STARTED, IN_PROGRESS, COMPLETED
  completedAt    DateTime?
  
  student        StudentProfile @relation(fields: [studentId], references: [id], onDelete: Cascade)
  lesson         Lesson         @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  
  @@unique([studentId, lessonId])
}

model ModuleProgress {
  id             String       @id @default(cuid())
  studentId      String
  moduleId       String
  status         String       @default("LOCKED") // LOCKED, UNLOCKED, IN_PROGRESS, COMPLETED
  completedAt    DateTime?
  
  student        StudentProfile @relation(fields: [studentId], references: [id], onDelete: Cascade)
  module         Module         @relation(fields: [moduleId], references: [id], onDelete: Cascade)
  
  @@unique([studentId, moduleId])
}

model Quiz {
  id             String       @id @default(cuid())
  title          String
  moduleId       String
  module         Module       @relation(fields: [moduleId], references: [id], onDelete: Cascade)
  questions      Question[]
  attempts       QuizAttempt[]
  
  @@index([moduleId])
}

model Question {
  id             String       @id @default(cuid())
  quizId         String
  text           String
  type           String       @default("MULTIPLE_CHOICE")
  options        String       // JSON string
  correctAnswer  String       // JSON string
  
  quiz           Quiz         @relation(fields: [quizId], references: [id], onDelete: Cascade)
  
  @@index([quizId])
}

model QuizAttempt {
  id             String       @id @default(cuid())
  studentId      String
  quizId         String
  score          Int
  passed         Boolean      @default(false)
  createdAt      DateTime     @default(now())
  
  student        StudentProfile @relation(fields: [studentId], references: [id], onDelete: Cascade)
  quiz           Quiz           @relation(fields: [quizId], references: [id], onDelete: Cascade)
  
  @@index([studentId])
  @@index([quizId])
}

model Assignment {
  id             String       @id @default(cuid())
  moduleId       String
  title          String
  description    String
  
  module         Module       @relation(fields: [moduleId], references: [id], onDelete: Cascade)
  submissions    Submission[]
  
  @@index([moduleId])
}

model Submission {
  id             String       @id @default(cuid())
  assignmentId   String
  studentId      String
  contentUrl     String
  status         String       @default("SUBMITTED") // SUBMITTED, GRADED, REJECTED
  
  assignment     Assignment   @relation(fields: [assignmentId], references: [id], onDelete: Cascade)
  student        StudentProfile @relation(fields: [studentId], references: [id], onDelete: Cascade)
  aiGrade        AIGrade?
  
  @@index([assignmentId])
  @@index([studentId])
}

model AIGrade {
  id             String       @id @default(cuid())
  submissionId   String       @unique
  score          Int
  feedback       String
  createdAt      DateTime     @default(now())
  
  submission     Submission   @relation(fields: [submissionId], references: [id], onDelete: Cascade)
}

model Assessment {
  id             String       @id @default(cuid())
  title          String
  description    String
  scores         AssessmentScore[]
}

model AssessmentScore {
  id             String       @id @default(cuid())
  assessmentId   String
  studentId      String
  score          Int
  
  assessment     Assessment     @relation(fields: [assessmentId], references: [id], onDelete: Cascade)
  student        StudentProfile @relation(fields: [studentId], references: [id], onDelete: Cascade)
  
  @@unique([assessmentId, studentId])
}

model CompetencyScore {
  id             String       @id @default(cuid())
  studentId      String
  competency     String       // e.g. "Objection Handling"
  score          Int          // 1-100
  updatedAt      DateTime     @updatedAt
  
  student        StudentProfile @relation(fields: [studentId], references: [id], onDelete: Cascade)
  
  @@unique([studentId, competency])
}

model PortfolioArtifact {
  id             String       @id @default(cuid())
  studentId      String
  title          String
  url            String
  createdAt      DateTime     @default(now())
  
  student        StudentProfile @relation(fields: [studentId], references: [id], onDelete: Cascade)
  
  @@index([studentId])
}

model CertificationAttempt {
  id             String       @id @default(cuid())
  studentId      String
  status         String       @default("PENDING") // PENDING, PASSED, FAILED
  issuedAt       DateTime?
  
  student        StudentProfile @relation(fields: [studentId], references: [id], onDelete: Cascade)
  
  @@index([studentId])
}

model InternshipOpportunity {
  id             String       @id @default(cuid())
  title          String
  companyName    String
  description    String
  createdAt      DateTime     @default(now())
}

model Application {
  id             String       @id @default(cuid())
  studentId      String
  status         String       @default("PENDING") // PENDING, APPROVED, REJECTED
  
  student        StudentProfile @relation(fields: [studentId], references: [id], onDelete: Cascade)
  
  @@index([studentId])
}

model Payment {
  id             String       @id @default(cuid())
  studentId      String
  amount         Float
  status         String       @default("COMPLETED")
  createdAt      DateTime     @default(now())
  
  student        StudentProfile @relation(fields: [studentId], references: [id], onDelete: Cascade)
  
  @@index([studentId])
}

model Part {
  id             String       @id @default(cuid())
  name           String
  orderIndex     Int
  
  modules        Module[]
}

model Course {
  id             String       @id @default(cuid())
  title          String
  description    String?
  slug           String       @unique
  organizationId String
  isFree         Boolean      @default(false)
  price          Float?       // Nullable, used if isFree is false
  currency       String       @default("USD")
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  modules        Module[]
  enrollments    Enrollment[]
