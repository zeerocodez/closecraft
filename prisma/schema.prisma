generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// -----------------------------------------------------------------------------
// IDENTITY & MULTI-TENANCY
// -----------------------------------------------------------------------------

model User {
  id            String    @id @default(cuid())
  platformRole  String    @default("USER")
  email         String    @unique
  name          String?
  passwordHash  String?
  emailVerified DateTime?
  image         String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  whatsappPhoneNumberId String? @unique
  payments PaymentTransaction[]

  // Relations
  memberships   OrganizationMember[]
  studentProfile StudentProfile?
}

model Organization {
  id            String    @id @default(cuid())
  name          String
  slug          String    @unique
  plan          String    @default("STARTER") // e.g. STARTER, GROWTH, SCALE
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  // Relations
  members       OrganizationMember[]
  leads         Lead[]
  conversations Conversation[]
  appointments  Appointment[]
  aiActions     AiAction[]
  deals         Deal[]
  auditLogs     AuditLog[]
  followUpTasks FollowUpTask[]
  
  // LMS Relations
  studentProfiles StudentProfile[]
  cohorts         Cohort[]
  modules         Module[]
  roleplayScenarios RoleplayScenario[]
}

model OrganizationMember {
  id             String       @id @default(cuid())
  role           String       @default("MEMBER") // ADMIN, CLOSER, MEMBER
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  // Foreign Keys
  userId         String
  organizationId String

  // Relations
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([userId, organizationId])
  @@index([organizationId])
}

// -----------------------------------------------------------------------------
// CORE SAAS & CRM (TENANT ISOLATED)
// -----------------------------------------------------------------------------

model Lead {
  id             String       @id @default(cuid())
  type           String       @default("MARKETING_LEAD") // MARKETING_LEAD, SALES_LEAD
  name           String
  email          String
  phone          String?
  message        String?
  status         String       @default("NEW") // NEW, QUALIFIED, CONTACTED, SCHEDULED, CLOSED
  source         String?      // e.g., Website Widget, Manual Import
  buyingIntent   Int?         // 1-100 AI score
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  // Foreign Keys
  organizationId String?      // Optional for platform-owned marketing leads, required for SaaS leads

  // Relations
  organization   Organization? @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  conversations  Conversation[]
  appointments   Appointment[]
  aiActions      AiAction[]
  deals          Deal[]
  auditLogs      AuditLog[]
  followUpTasks  FollowUpTask[]
  qualificationData QualificationData?

  @@index([organizationId])
  @@index([email])
}

model Conversation {
  id             String       @id @default(cuid())
  channel        String       @default("WHATSAPP") // WEB, EMAIL, WHATSAPP
  status         String       @default("ACTIVE") // ACTIVE, CLOSED, PAUSED
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  // Foreign Keys
  leadId         String
  organizationId String

  // Relations
  lead           Lead         @relation(fields: [leadId], references: [id], onDelete: Cascade)
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  messages       Message[]

  @@index([organizationId])
  @@index([leadId])
}

model Appointment {
  id             String       @id @default(cuid())
  scheduledAt    DateTime
  status         String       @default("SCHEDULED") // SCHEDULED, COMPLETED, NO_SHOW, CANCELLED
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  // Foreign Keys
  leadId         String
  organizationId String

  // Relations
  lead           Lead         @relation(fields: [leadId], references: [id], onDelete: Cascade)
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId])
}

model AiAction {
  id             String       @id @default(cuid())
  actionType     String       // e.g. QUALIFY, DRAFT_EMAIL, RECOMMEND_NEXT_STEP
  confidence     Float        // e.g. 0.95
  result         String
  status         String       @default("PENDING_APPROVAL") // PENDING_APPROVAL, APPROVED, REJECTED, EXECUTED
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  // Foreign Keys
  leadId         String
  organizationId String

  // Relations
  lead           Lead         @relation(fields: [leadId], references: [id], onDelete: Cascade)
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId])
}

model Deal {
  id             String       @id @default(cuid())
  amount         Float
  currency       String       @default("USD")
  stage          String       @default("OPPORTUNITY") // OPPORTUNITY, PROPOSAL, WON, LOST
  closedAt       DateTime?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  // Foreign Keys
  leadId         String
  organizationId String

  // Relations
  lead           Lead         @relation(fields: [leadId], references: [id], onDelete: Cascade)
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId])
}

model Message {
  id             String       @id @default(cuid())
  content        String
  senderType     String       // AI, HUMAN, PROSPECT
  createdAt      DateTime     @default(now())

  conversationId String
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([conversationId])
}

model AuditLog {
  id             String       @id @default(cuid())
  actorId        String?
  actorType      String       // USER, AI, SYSTEM, INTEGRATION
  action         String
  resourceType   String
  resourceId     String
  oldState       String?
  newState       String?
  createdAt      DateTime     @default(now())

  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  leadId         String?
  lead           Lead?        @relation(fields: [leadId], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@index([leadId])
}

model FollowUpTask {
  id             String       @id @default(cuid())
  actionType     String       // e.g. SEND_WHATSAPP, NOTIFY_SALES
  scheduledFor   DateTime
  status         String       @default("PENDING") // PENDING, EXECUTED, CANCELLED
  reason         String?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  leadId         String
  lead           Lead         @relation(fields: [leadId], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@index([leadId])
  @@index([status, scheduledFor])
}

model QualificationData {
  id             String       @id @default(cuid())
  budget         String?
  authority      String?
  need           String?
  timeline       String?
  customData     String?      // JSON string for extra fields
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  leadId         String       @unique
  lead           Lead         @relation(fields: [leadId], references: [id], onDelete: Cascade)
}


// -----------------------------------------------------------------------------
// DSS LEARNING MANAGEMENT SYSTEM (LMS)
// -----------------------------------------------------------------------------

model StudentProfile {
  id             String       @id @default(cuid())
  bio            String?
  track          String?      // SETTER, CLOSER
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  userId         String       @unique
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  moduleProgress ModuleProgress[]
  enrollments    Enrollment[]
  roleplaySessions RoleplaySession[]
  
  @@index([organizationId])
}

model Cohort {
  id             String       @id @default(cuid())
  name           String
  startDate      DateTime
  endDate        DateTime?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  
  enrollments    Enrollment[]

  @@index([organizationId])
}

model Enrollment {
  id             String       @id @default(cuid())
  status         String       @default("ACTIVE") // ACTIVE, COMPLETED, DROPPED
  enrolledAt     DateTime     @default(now())

  studentId      String
  student        StudentProfile @relation(fields: [studentId], references: [id], onDelete: Cascade)
  
  cohortId       String
  cohort         Cohort       @relation(fields: [cohortId], references: [id], onDelete: Cascade)

  @@unique([studentId, cohortId])
  @@index([cohortId])
}

model Module {
  id             String       @id @default(cuid())
  title          String
  orderIndex     Int
  description    String?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  
  progress       ModuleProgress[]
  lessons        Lesson[]

  @@index([organizationId])
}

model Lesson {
  id             String       @id @default(cuid())
  title          String
  orderIndex     Int
  contentUrl     String?      // Video or PDF link
  transcript     String?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  moduleId       String
  module         Module       @relation(fields: [moduleId], references: [id], onDelete: Cascade)

  @@index([moduleId])
}

model RoleplayScenario {
  id             String       @id @default(cuid())
  title          String
  buyerPersona   String       // e.g., CEO, CTO, CFO
  context        String       // Scenario instructions for the AI
  rubric         String       // JSON defining what to score (e.g. discovery, objection handling)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  sessions       RoleplaySession[]

  @@index([organizationId])
}

model RoleplaySession {
  id             String       @id @default(cuid())
  status         String       @default("IN_PROGRESS") // IN_PROGRESS, COMPLETED, FAILED
  finalScore     Int?
  feedback       String?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  studentId      String
  student        StudentProfile @relation(fields: [studentId], references: [id], onDelete: Cascade)
  
  scenarioId     String
  scenario       RoleplayScenario @relation(fields: [scenarioId], references: [id], onDelete: Cascade)

  turns          RoleplayTurn[]

  @@index([studentId])
  @@index([scenarioId])
}

model RoleplayTurn {
  id             String       @id @default(cuid())
  content        String
  senderType     String       // STUDENT, AI_BUYER
  createdAt      DateTime     @default(now())

  sessionId      String
  session        RoleplaySession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@index([sessionId])
}


// Created only by trusted server billing code, before redirecting to Paystack.
model PaymentTransaction {
  reference String @id
  organizationId String
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  amount Int
  currency String
  plan String
  processedAt DateTime?
  createdAt DateTime @default(now())
}

// Completion is recorded by trusted assessment code, never by the browser.
model ModuleProgress {
  studentId String
  moduleId String
  completedAt DateTime?
  student StudentProfile @relation(fields: [studentId], references: [id], onDelete: Cascade)
  module Module @relation(fields: [moduleId], references: [id], onDelete: Cascade)
  @@id([studentId, moduleId])
}

model PublicFormRateLimit {
  key String @id
  count Int @default(1)
  expiresAt DateTime
  @@index([expiresAt])
}
